{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "bun"]
  },
  "include": [
    "contracts/src/**/*.test.ts",
    "shared/src/**/*.test.ts",
    "shared/src/**/*.test.tsx",
    "public/src/**/*.test.ts",
    "public/src/**/*.test.tsx",
    "admin/src/**/*.test.ts",
    "admin/src/**/*.test.tsx",
    "admin/src/**/*-fixture.ts",
    "admin/src/**/*-fixture.tsx",
    "tooling/env.d.ts",
    "tooling/test-runtime.ts",
    "tooling/*.test.ts"
  ]
}
