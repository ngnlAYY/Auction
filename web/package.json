{
  "name": "auction-web",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun run typecheck:contracts && bun run typecheck:shared && bun run typecheck:public && bun run typecheck:admin && bun run typecheck:tooling && bun run typecheck:test",
    "typecheck:contracts": "bun ./node_modules/.bin/tsc --noEmit -p contracts",
    "typecheck:shared": "bun ./node_modules/.bin/tsc --noEmit -p shared",
    "typecheck:public": "bun ./node_modules/.bin/tsc --noEmit -p public",
    "typecheck:admin": "bun ./node_modules/.bin/tsc --noEmit -p admin",
    "typecheck:tooling": "bun ./node_modules/.bin/tsc --noEmit -p tsconfig.json",
    "typecheck:test": "bun ./node_modules/.bin/tsc --noEmit -p tsconfig.test.json",
    "lint": "bun ./node_modules/.bin/biome check .",
    "format": "bun ./node_modules/.bin/biome check --write .",
    "test": "bun test --conditions=browser --conditions=development",
    "build:public": "bun ./node_modules/.bin/vite build --config public/vite.config.ts",
    "build:admin": "bun ./node_modules/.bin/vite build --config admin/vite.config.ts",
    "dev:public": "bun ./node_modules/.bin/vite --config public/vite.config.ts",
    "dev:admin": "bun ./node_modules/.bin/vite --config admin/vite.config.ts"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "@solidjs/web": "2.0.0",
    "solid-js": "2.0.0",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@solidjs/vite-plugin": "3.0.0",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
