admin-credentials-kind = 類型
admin-credentials-kind-mail = mail_cookie
admin-credentials-kind-forum = forum_cookie
admin-credentials-world = 世界
admin-credentials-world-main = main
admin-credentials-world-isekai = isekai
admin-credentials-world-shared = shared
admin-credentials-label = 帳號名稱
