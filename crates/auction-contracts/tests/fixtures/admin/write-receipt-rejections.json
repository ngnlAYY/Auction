      ],
      "responses": [
        {"http_status": 409, "ruling": "replay_checked", "display_code": null},
        {"http_status": 400, "ruling": "unknown", "display_code": "http_400"},
        {"http_status": 401, "ruling": "unknown", "display_code": "http_401"},
        {"http_status": 403, "ruling": "unknown", "display_code": "http_403"},
        {"http_status": 404, "ruling": "unknown", "display_code": "http_404"},
        {"http_status": 422, "ruling": "unknown", "display_code": "http_422"},
        {"http_status": 429, "ruling": "unknown", "display_code": "http_429"},
        {"http_status": 500, "ruling": "unknown", "display_code": "http_500"},
        {"http_status": 502, "ruling": "unknown", "display_code": "http_502"},
        {"http_status": 503, "ruling": "unknown", "display_code": "http_503"},
        {"http_status": 504, "ruling": "unknown", "display_code": "http_504"}
      ]
    },
    {
      "endpoints": ["user-mutation", "rules-publish", "about-publish"],
      "protocol_codes": ["state_conflict"],
      "responses": [
        {"http_status": 409, "ruling": "replay_checked", "display_code": null},
        {"http_status": 400, "ruling": "unknown", "display_code": "http_400"},
        {"http_status": 503, "ruling": "unknown", "display_code": "http_503"}
      ]
    },
    {
      "endpoints": ["general", "rename-revert", "mail-template"],
      "protocol_codes": ["state_conflict"],
      "responses": [
        {"http_status": 409, "ruling": "unknown", "display_code": null},
        {"http_status": 400, "ruling": "unknown", "display_code": null},
        {"http_status": 503, "ruling": "unknown", "display_code": null}
      ]
    }
  ]
}
