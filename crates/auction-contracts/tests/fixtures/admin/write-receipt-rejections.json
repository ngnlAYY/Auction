        {"http_status": 418, "ruling": "unknown", "display_code": "http_418"}
      ]
    },
    {
      "endpoints": ["general"],
      "protocol_codes": ["feature_not_supported"],
      "responses": [
        {"http_status": 501, "ruling": "this_attempt", "display_code": null},
        {"http_status": 418, "ruling": "unknown", "display_code": "http_418"}
      ]
    },
    {
      "endpoints": ["general"],
      "protocol_codes": ["credential_login_unavailable"],
      "responses": [
        {"http_status": 503, "ruling": "this_attempt", "display_code": null},
        {"http_status": 418, "ruling": "unknown", "display_code": "http_418"}
      ]
    },
    {
      "endpoints": ["general"],
      "protocol_codes": [
        "alert_stale",
        "stale_auction_state",
        "stale_lot_state",
        "stale_user_state",
        "rename_not_revertable",
        "mail_template_conflict",
        "runtime_switch_conflict",
        "already_disposed",
