# Web payload 体积预算；schema 与字段由 ci/release/build-identity.sh 的 verify_web_size_budget 读取。
# baseline 是刻意复核过的发布 payload 实测值（web-embed 内嵌的全部普通文件），不是自动跟随构建刷新的值。
# 体积超过 baseline + warn_growth_basis_points（万分比）只告警；超过 *_max_bytes 使发布门禁失败。
# 刷新方式见 ci/README.md「Web payload 体积预算」；只允许在确认增长合理时与源码改动同批更新。
schema=auction-web-size-budget/1
warn_growth_basis_points=500
# 2026-11-18：前端审计第二波修复之后按本地 `mise run web-build` 实测刷新 Public 基线。增量来自
# 结果未知命令的保留与原样重试、会话对账、场次参数与读取页的校验等页面逻辑（依赖与 feature 未变）；
# 无参数 t! 的展开已收拢为一个函数，收回约 95 KB 后仍高于旧上限。上限保持在基线约 +5%。
public_wasm_baseline_bytes=3201271
public_wasm_max_bytes=3360000
public_payload_baseline_bytes=3561755
public_payload_max_bytes=3740000
# 2026-11-19：在双栈构建车道的沙箱内实跑 `AUCTION_WEB_STACK=solid ci/release/web-bundle.sh public`
# 后按 `web_payload_sizes` 实测刷新 Solid Public 基线；initial_js 是入口模块与 modulepreload 脚本的
# 原始字节去重和，payload 是全部普通文件（不含 brotli 副本）之和。上限保持在基线约 +5%。
solid_public_initial_js_baseline_bytes=333953
solid_public_initial_js_max_bytes=351000
solid_public_payload_baseline_bytes=950484
solid_public_payload_max_bytes=999000
# 2026-11-17：v0.1.7 发布构建实测刷新 Admin 基线（结算退件页面等约 4,472 行前端新增）；
# 上限保持在基线约 +5%，继续拦截进一步明显增长。
admin_wasm_baseline_bytes=4520796
admin_wasm_max_bytes=4750000
admin_payload_baseline_bytes=5294901
admin_payload_max_bytes=5560000
# 2026-11-19：Admin 的 Solid 实现接入构建后，在收口的工作树上实跑
# `AUCTION_WEB_STACK=solid mise run web-build`，按 `web_payload_sizes admin target/web/admin` 实测加入。
# Admin 目前是单个入口模块（没有按路由分块），initial_js 即整份入口脚本。上限保持在基线约 +5%。
solid_admin_initial_js_baseline_bytes=1180043
solid_admin_initial_js_max_bytes=1240000
solid_admin_payload_baseline_bytes=1935094
solid_admin_payload_max_bytes=2032000
