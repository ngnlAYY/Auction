# Auction PostgreSQL 18 服务端基线
# 本文件是片段模板，不替代发行版 postgresql.conf；合并前核对现有值，重启受停机时段门禁约束。
# 连接预算见 ops/postgres/README.md；所有服务仍只监听本机。

listen_addresses = '127.0.0.1'
port = 5432

# 三角色服务池各 16（含长期 owner），维护池 4，最多 2 个并行 CLI，
# 外部/备份/exporter/人工会话预留 8；3 个 superuser 保留连接。
max_connections = 100
superuser_reserved_connections = 3
reserved_connections = 0

shared_buffers = 128MB
work_mem = 4MB
maintenance_work_mem = 64MB

# 热点分析依赖；需要 CREATE EXTENSION 和重启。
shared_preload_libraries = 'pg_stat_statements'
pg_stat_statements.max = 10000
pg_stat_statements.track = all

# 慢查询与锁等待；应用层仍有自己的 1 秒慢语句告警。
log_min_duration_statement = 1000
# 慢语句只记录 SQL 与时长，不记录绑定参数，避免凭据、Cookie、登录 key 或邮件正文进入日志。
log_parameter_max_length = 0
log_parameter_max_length_on_error = 0
log_lock_waits = on
log_autovacuum_min_duration = 1000
log_checkpoints = on
log_temp_files = 10240

# 归档与时间点恢复：默认保持关闭。打开 archive_mode 需要重启 PostgreSQL，
# 受停机时段门禁约束；启用前必须先安装含 `wal archive`/`wal upload` 的 auction-cli、
# 建好暂存目录并让上传 timer 至少成功运行一次（见 ops/deploy/RECOVERY.md）。
# archive_command 由 postgres 账号执行，不读敏感 TOML；收件人公钥不是秘密，直接写在参数里。
# 任一步失败返回非零，由 PostgreSQL 重试同一段；暂存积压会撑满磁盘，须监控
# pg_stat_archiver.failed_count、暂存目录占用与上传 timer 状态。
archive_mode = off
# archive_mode = on
# archive_command = '/opt/auction/bin/auction-cli wal archive --staging-dir /var/lib/auction/wal-staging --recipient age1<收件人公钥> %p %f'
# archive_timeout = 300

# 不使用 archive_library：归档只走本机命令，压缩与加密都在暂存目录完成。
# 时间点恢复窗口 14 天、WAL 与基础备份保留 21 天（决策 49），由 R2 生命周期与锁定期实现。

# 明确保持自动清理开启；每表参数由 autovacuum.sql.example 设置。
autovacuum = on
track_counts = on

password_encryption = 'scram-sha-256'
