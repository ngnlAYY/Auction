# 分体部署的共享运行根；以 root:root、0644 安装为 /etc/tmpfiles.d/hv-auction.conf。
# Public/Admin 的 Unix listener 与锁文件位于此目录；反向代理只需组遍历权限，不得授予写权限。
# 不设置 age：只创建并调整根目录，不清理其中的 socket 或实例锁。
# Worker unit 只通过 RuntimeDirectory 管理 /run/hv-auction/worker，不得接管共享根。
d /run/hv-auction 0750 auction auction - -

# W10.7 WAL 暂存：归档命令由 postgres 账号执行、上传器由 auction 账号执行，因此共享组写权限。
# 2770 = setgid，使新建密文继承 auction 组；归档密文与 manifest 发布为 0640。
# 该目录可随时创建；只有 postgresql.conf 打开 archive_mode 后才会产生文件。
d /var/lib/auction/wal-staging 2770 postgres auction - -
