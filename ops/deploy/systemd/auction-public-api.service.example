[Unit]
Description=Auction Rust Public API
After=network-online.target auction-worker.service auction-admin-api.service
Wants=network-online.target auction-worker.service auction-admin-api.service
# 故障域隔离：Wants= 只表达启动期望，不传播停止/失败。Worker 或 Admin 重启不会连带停止本服务；
# 启动顺序仍由 After= 与 auction-cli service（auction-stack.service）保证。

[Service]
Type=simple
User=auction
Group=auction
WorkingDirectory=/opt/auction
Environment=AUCTION_CONFIG_FILE=/etc/auction/public.toml
ExecStart=/opt/auction/bin/auction-public-api
Restart=on-failure
RestartSec=5s
# 普通 10 + 关键段 0 + tracing 上限 30 + 余量 5 = 45 秒；提高应用预算须同步提高 unit 上限。
TimeoutStopSec=45s
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/hv-auction
LimitNOFILE=65536
# --- 主机加固：资源上限与沙箱 ---
# 上限是失控保护，不是容量规划：按约 1.9 GB 内存的单机取值，远高于正常占用。
# 若 MemoryCurrent 长期接近上限，先核对真实占用再调大，不能把 OOM 当正常回收。
MemoryMax=512M
TasksMax=256
# 不写核心转储：转储可能含会话、Cookie 与密钥材料。
LimitCORE=0
# 服务不需要任何 Linux capability。
CapabilityBoundingSet=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
# 只保留本进程可见的 /proc 与 pid 子集；/proc/self 与 sched_getaffinity 仍可用。
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Rust 服务没有 JIT；若将来引入运行时生成代码的依赖须先移除本行。
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
