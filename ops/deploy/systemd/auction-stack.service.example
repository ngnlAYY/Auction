# 分体部署的顺序控制 unit：开机或手动 start 时预检、迁移并按 Worker → Admin → Public 启动，
# stop 时反序停止。以 root 运行以调用 systemctl；Worker control 的 allowed_peer_uids 须包含 0，
# 否则无法探测 Worker readiness。三个角色 unit 不要单独 enable，由本 unit 统一编排。
[Unit]
Description=Auction ordered deployment controller (auction-cli service)
After=network-online.target systemd-tmpfiles-setup.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/auction
UMask=0077
# 部署控制锁目录；auction-cli 也会在缺失时以 0700 创建。
StateDirectory=auction/deployment
StateDirectoryMode=0700
ExecStart=/opt/auction/bin/auction-cli --config-dir /etc/auction service start --startup-timeout-seconds 30
ExecStop=/opt/auction/bin/auction-cli --config-dir /etc/auction service stop
# 迁移加三个角色各 30 秒 readiness，另留 systemctl 往返余量。
TimeoutStartSec=180
# 普通 + 关键段 + tracing 上限 + 余量：角色 unit 默认 45 + 45 + 120 = 210 秒。
# 含 CLI 每角色回执余量、属性查询和最后收口，总预算 330 秒；提高应用预算须同步提高 unit 上限。
TimeoutStopSec=330s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/auction /opt/auction
ReadWritePaths=/var/lib/auction
# --- 主机加固：资源上限与保守沙箱 ---
# 本 unit 以 root 运行 auction-cli 并调用 systemctl，失败即整套服务起不来，
# 因此只加不改变编排能力的选项：不加 CapabilityBoundingSet=、SystemCallFilter=
# 与 ProtectProc=，避免过滤 systemctl/D-Bus 所需调用或隐藏其他角色的 /proc。
# 需要进一步收紧时，先在演练主机用 systemd-analyze security 与一次完整
# service stop/start 验证后再合入。上限按单机约 1.9 GB 内存取 512M。
MemoryMax=512M
TasksMax=128
LimitCORE=0
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
