# 合并制品专用：auction-server 在一个 unit 内以子进程监管 Worker、Admin、Public。
# 不得与三个分体 unit 或 auction-stack.service 同时启用。配置目录不存在时首次启动进入
# 本机设置页（默认 127.0.0.1:8091），保存后初始化专用空库再启动三个角色。
[Unit]
Description=Auction single-binary supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auction
Group=auction
WorkingDirectory=/var/lib/auction
# 配置目录 /var/lib/auction/config 与同级运行目录 /var/lib/auction/.config.server 都在这里。
StateDirectory=auction
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/auction/bin/auction-server --config-dir /var/lib/auction/config
# 首次初始化或迁移失败须人工核对，不用自动重启掩盖结果。
Restart=no
# SIGTERM 只发给 supervisor，由它按 Public → Admin → Worker 反序收口子进程。
KillMode=mixed
# 普通 + 关键段 + tracing 上限 + 余量：三角色默认 45 + 45 + 105 = 195 秒。
# 再留三次强制回收各 5 秒及外层余量，总计 225 秒；提高应用预算须同步提高 unit 上限。
TimeoutStopSec=225s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/auction
LimitNOFILE=65536
# --- W9.6 主机加固：资源上限与沙箱 ---
# 本 unit 的 cgroup 同时包含三个子进程，上限须高于分体部署三角色之和；
# 按单机约 1.9 GB 内存取 1200M，属失控保护而非容量规划。
MemoryMax=1200M
TasksMax=1024
# 不写核心转储：转储可能含会话、Cookie 与密钥材料。
LimitCORE=0
# 服务不需要任何 Linux capability。
CapabilityBoundingSet=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
# 只保留本进程可见的 /proc 与 pid 子集；/proc/self 与 sched_getaffinity 仍可用。
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Rust 服务没有 JIT；若将来引入运行时生成代码的依赖须先移除本行。
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
