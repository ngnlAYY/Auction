# 合并制品专用：auction-server 在一个 unit 内以子进程监管 Worker、Admin、Public。
# 不得与三个分体 unit 或 auction-stack.service 同时启用。配置目录不存在时首次启动进入
# 本机设置页（默认 127.0.0.1:8091），保存后初始化专用空库再启动三个角色。
[Unit]
Description=Auction single-binary supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=auction
Group=auction
WorkingDirectory=/var/lib/auction
# 配置目录 /var/lib/auction/config 与同级运行目录 /var/lib/auction/.config.server 都在这里。
StateDirectory=auction
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/auction/bin/auction-server --config-dir /var/lib/auction/config
# 首次初始化或迁移失败须人工核对，不用自动重启掩盖结果。
Restart=no
# SIGTERM 只发给 supervisor，由它按 Public → Admin → Worker 反序收口子进程。
KillMode=mixed
# supervisor 的关闭总预算为 135 秒，另留回收余量。
TimeoutStopSec=155s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/auction
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
